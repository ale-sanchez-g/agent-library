{
  "testEnvironment": "node",
  "forceExit": true,
  "detectOpenHandles": true,
  "collectCoverageFrom": [
    "**/*.js",
    "!**/node_modules/**",
    "!**/coverage/**",
    "!jest.config.js"
  ],
  "coverageReporters": [
    "text",
    "lcov",
    "html"
  ],
  "coverageDirectory": "coverage",
  "testMatch": [
    "**/__tests__/**/*.js",
    "**/?(*.)+(spec|test).js"
  ],
  "verbose": true
}